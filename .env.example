# bot-deployer's own copy of the Telegram token, used only to send deploy
# result notifications (via combot's notify.py) -- never committed, kept in
# /etc/bot-deployer/bot-deployer.env in production, chmod 600.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Set if 212-bot isn't checked out as a sibling of this repo
# (../212-bot) -- e.g. because it hasn't yet migrated to the managed
# /var/lib/bot-deployer/apps/ layout that combot and bot-deployer use.
# BOT212_DIR=/path/to/212-bot
